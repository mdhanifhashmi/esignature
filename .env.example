# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of the app, no trailing slash. Used in tracked links and icons.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: AI suggestions (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the Gemini model
GEMINI_MODEL=gemini-2.5-flash

# Optional: team invite emails (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SigMotion <onboarding@resend.dev>
